{"displayName":"Lab Services should enable all options for auto shutdown","policyType":"BuiltIn","mode":"Indexed","description":"This policy provides helps with cost management by enforcing all automatic shutdown options are enabled for a lab.","metadata":{"version":"1.1.0","category":"Lab Services"},"version":"1.1.0","parameters":{"effect":{"type":"String","metadata":{"displayName":"Effect","description":"Enable or disable the execution of the policy"},"allowedValues":["Audit","Deny","Disabled"],"defaultValue":"Audit"},"excludeLabPlanId":{"type":"String","metadata":{"displayName":"Lab Plan Id to exclude","description":"Optionally enter the lab Plan Id to exclude for this policy assignment."},"defaultValue":""}},"policyRule":{"if":{"anyOf":[{"allOf":[{"field":"type","equals":"Microsoft.LabServices/labs"},{"field":"Microsoft.LabServices/labs/labPlanId","notEquals":"[parameters('excludeLabPlanId')]"},{"anyOf":[{"field":"Microsoft.LabServices/labs/autoShutdownProfile.shutdownOnDisconnect","equals":"Disabled"},{"field":"Microsoft.LabServices/labs/autoShutdownProfile.shutdownWhenNotConnected","equals":"Disabled"},{"field":"Microsoft.LabServices/labs/autoShutdownProfile.shutdownOnIdle","equals":"None"}]}]},{"allOf":[{"field":"type","equals":"Microsoft.LabServices/labplans"},{"anyOf":[{"field":"Microsoft.LabServices/labPlans/defaultAutoShutdownProfile.shutdownOnDisconnect","equals":"Disabled"},{"field":"Microsoft.LabServices/labPlans/defaultAutoShutdownProfile.shutdownWhenNotConnected","equals":"Disabled"},{"field":"Microsoft.LabServices/labPlans/defaultAutoShutdownProfile.shutdownOnIdle","equals":"None"}]}]}]},"then":{"effect":"[parameters('effect')]"}}}
