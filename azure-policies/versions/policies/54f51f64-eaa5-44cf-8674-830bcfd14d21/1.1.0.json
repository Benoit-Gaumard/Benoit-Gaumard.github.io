{"displayName":"Multi Factor Authentication Enforcement - Write","policyType":"BuiltIn","mode":"All","description":"This policy definition blocks resource create and update operations when the caller is not authenticated via MFA. For more information, visit https://aka.ms/mfaforazure.","metadata":{"version":"1.1.0","category":"System Policy"},"version":"1.1.0","parameters":{"effect":{"type":"String","metadata":{"displayName":"Effect","description":"The desired effect of the policy"},"allowedValues":["Audit","Deny","Disabled"],"defaultValue":"Audit"}},"policyRule":{"if":{"allOf":[{"value":"[contains(requestContext().identity, 'idtyp')]","equals":true},{"value":"[requestContext().identity.idtyp]","equals":"user"},{"value":"mfa","notIn":"[split(tryGet(requestContext().identity, 'http://schemas.microsoft.com/claims/authnmethodsreferences'), ',')]"},{"value":"p1","notIn":"[split(requestContext().identity.acrs, ',')]"}]},"then":{"effect":"[parameters('effect')]"}}}
