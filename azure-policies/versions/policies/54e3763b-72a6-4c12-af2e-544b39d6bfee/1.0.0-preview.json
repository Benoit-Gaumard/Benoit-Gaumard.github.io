{"displayName":"[Preview]: Azure Migrate projects should use private endpoints","policyType":"BuiltIn","mode":"Indexed","description":"Azure Private Link lets you connect your virtual networks to Azure services without a public IP address at the source or destination. By requiring an approved private endpoint connection for Azure Migrate projects, you can reduce data leakage risks.","metadata":{"version":"1.0.0-preview","preview":true,"category":"Sovereignty"},"version":"1.0.0-preview","parameters":{"effect":{"type":"String","metadata":{"displayName":"Effect","description":"Enable or disable the execution of the policy"},"allowedValues":["Audit","Disabled"],"defaultValue":"Audit"}},"policyRule":{"if":{"anyOf":[{"allOf":[{"field":"type","equals":"Microsoft.Migrate/assessmentProjects"},{"count":{"field":"Microsoft.Migrate/assessmentProjects/privateEndpointConnections[*]","where":{"field":"Microsoft.Migrate/assessmentProjects/privateEndpointConnections[*].privateLinkServiceConnectionState.status","equals":"Approved"}},"less":1}]},{"allOf":[{"field":"type","equals":"Microsoft.Migrate/migrateProjects"},{"count":{"field":"Microsoft.Migrate/migrateProjects/privateEndpointConnections[*]","where":{"field":"Microsoft.Migrate/migrateProjects/privateEndpointConnections[*].privateLinkServiceConnectionState.status","equals":"Approved"}},"less":1}]}]},"then":{"effect":"[parameters('effect')]"}}}
